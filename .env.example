# Copiloto de presupuestos: Claude Opus con tu API de Anthropic.
# En Vercel: Settings → Environment Variables → ANTHROPIC_API_KEY (Production + Preview).
# En local: la misma clave en .env.local
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron de Catastro (Vercel lo inyecta al desplegar el cron de /api/cron/catastro-zone)
# CRON_SECRET=

# Avisos PWA (Web Push). Generar con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:avisos@rehabinco.es

# Idealista vía Bright Data (no usa la API oficial).
# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_IDEALISTA_DATASET_ID=c_el_id_del_collector
# BRIGHTDATA_WEBHOOK_SECRET=
# BRIGHTDATA_IDEALISTA_URL=https://www.idealista.com/venta-viviendas/a-coruna-a-coruna/con-particulares/
# BRIGHTDATA_WEBHOOK_URL=https://tu-dominio/api/captacion/brightdata

# Idealista / Fotocasa: también se pueden pegar en Ajustes → APIs de portales (solo admin).
# IDEALISTA_API_KEY=
# IDEALISTA_API_SECRET=
# FOTOCASA_API_KEY=
# FOTOCASA_API_SECRET=


# Datos empresa (para facturas impresas/PDF)
NEXT_PUBLIC_BILLING_COMPANY_NAME=Tu Empresa S.L.
NEXT_PUBLIC_BILLING_COMPANY_NIF=B00000000
NEXT_PUBLIC_BILLING_COMPANY_ADDRESS=Calle Ejemplo 1
NEXT_PUBLIC_BILLING_COMPANY_CP=28001
NEXT_PUBLIC_BILLING_COMPANY_CITY=Madrid
NEXT_PUBLIC_BILLING_COMPANY_PROVINCE=Madrid
NEXT_PUBLIC_BILLING_COMPANY_IBAN=ES00 0000 0000 0000 0000 0000
# Opcional: URL abs. o ruta /... del logotipo en facturas (también en Ajustes → Datos de empresa)
# Vacío = logo blanco Rehabinco sobre cabecera azul
# NEXT_PUBLIC_BILLING_LOGO_URL=/images/facturas/rehabinco-blanco.png

# Obsoleto para el número de factura: ahora se usa N/AAAA y FR-N/AAAA (ver lib/facturacion-numeracion.ts)
# NEXT_PUBLIC_BILLING_SERIE=RHB
